<Project Sdk="Microsoft.NET.Sdk">
  <!-- Game references and target framework come from ..\Directory.Build.props.
       Deploying to the game is opt-in: see ..\Directory.Build.targets. -->
  <PropertyGroup>
    <AssemblyName>NetworkCrashFix</AssemblyName>
    <RootNamespace>NetworkCrashFix</RootNamespace>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- This mod's icon in the row of mod icons at the bottom-right. IconBar hides the row with
         the game's eye button through PanelStack. -->
    <Compile Include="..\Shared\PanelStack.cs" Link="Shared\PanelStack.cs" />
    <Compile Include="..\Shared\IconBar.cs" Link="Shared\IconBar.cs" />
  </ItemGroup>
</Project>
