<Project Sdk="Microsoft.NET.Sdk">
  <!-- Game references and target framework come from ..\Directory.Build.props.
       Deploying to the game is opt-in: see ..\Directory.Build.targets. -->
  <PropertyGroup>
    <AssemblyName>NetworkCrashFix</AssemblyName>
    <RootNamespace>NetworkCrashFix</RootNamespace>
    <Version>0.1.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- No icon in the game (the fix is always on). Icon.cs is only read by Thunderstore\pack.py
         for the package's icon.png, so it isn't compiled. -->
    <Compile Remove="Icon.cs" />
  </ItemGroup>
</Project>
