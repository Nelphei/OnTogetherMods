<Project>
  <!-- When built with -p:DeployToGame=true, copy the mod into BepInEx\plugins\<ModName>\
       so the game picks it up on next launch. Normal builds skip this. -->
  <Target Name="DeployToGame" AfterTargets="Build" Condition="'$(DeployToGame)' == 'true'">
    <PropertyGroup>
      <PluginDeployDir>$(BepInExDir)\plugins\$(AssemblyName)</PluginDeployDir>
    </PropertyGroup>
    <ItemGroup>
      <DeployFiles Include="$(TargetPath)" />
      <DeployFiles Include="$(TargetDir)$(TargetName).pdb" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
    </ItemGroup>

    <!-- If this fails with "file is being used by another process", close the game and build again. -->
    <Copy SourceFiles="@(DeployFiles)" DestinationFolder="$(PluginDeployDir)" Retries="2" RetryDelayMilliseconds="500" />
    <Message Importance="high" Text="Deployed $(TargetFileName) -> $(PluginDeployDir)" />
  </Target>
</Project>
