<Project>
  <!-- Shared settings for every mod project in this folder. -->

  <PropertyGroup>
    <!-- Override with: dotnet build -p:GameDir="D:\SteamLibrary\...\On-Together" -->
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\On-Together\On-Together</GameDir>
    <ManagedDir>$(GameDir)\OnTogether_Data\Managed</ManagedDir>
    <BepInExDir>$(GameDir)\BepInEx</BepInExDir>

    <!-- The game's code is built against .NET Standard 2.1 (Unity 6, Mono). -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

    <!-- Builds stay in each project's bin\ folder. To also copy into the game's plugins folder,
         run: dotnet build -p:DeployToGame=true  (or the "deploy to game" task in VS Code). -->
    <DeployToGame Condition="'$(DeployToGame)' == ''">false</DeployToGame>
  </PropertyGroup>

  <ItemGroup>
    <!-- BepInEx + HarmonyX, from the game's BepInEx install. -->
    <Reference Include="$(BepInExDir)\core\BepInEx.dll" Private="false" />
    <Reference Include="$(BepInExDir)\core\0Harmony.dll" Private="false" />

    <!-- Every game/Unity DLL except the .NET system libraries (those come from netstandard2.1).
         Private="false" means they're never copied into our output: the game already has them. -->
    <Reference Include="$(ManagedDir)\*.dll"
               Exclude="$(ManagedDir)\mscorlib.dll;$(ManagedDir)\netstandard.dll;$(ManagedDir)\System*.dll;$(ManagedDir)\Mono.*.dll"
               Private="false" />
  </ItemGroup>
</Project>
