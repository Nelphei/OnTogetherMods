<Project Sdk="Microsoft.NET.Sdk">
  <!-- Game references and target framework come from ..\Directory.Build.props.
       Deploying to the game is opt-in: see ..\Directory.Build.targets. -->
  <PropertyGroup>
    <AssemblyName>DeskSwarm</AssemblyName>
    <RootNamespace>DeskSwarm</RootNamespace>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Stacks this mod's window with other mods' windows. -->
    <Compile Include="..\Shared\PanelStack.cs" Link="Shared\PanelStack.cs" />
    <!-- This mod's icon in the row of mod icons at the bottom-right. -->
    <Compile Include="..\Shared\IconBar.cs" Link="Shared\IconBar.cs" />
    <!-- Keeps clicks on the window from reaching the game's UI. -->
    <Compile Include="..\Shared\ClickBlocker.cs" Link="Shared\ClickBlocker.cs" />
    <!-- The messages at the top of the screen, and player names in the window. -->
    <Compile Include="..\Shared\TextBox.cs" Link="Shared\TextBox.cs" />
    <Compile Include="..\Shared\PlayerNames.cs" Link="Shared\PlayerNames.cs" />
  </ItemGroup>
</Project>
