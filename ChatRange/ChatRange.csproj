<Project Sdk="Microsoft.NET.Sdk">
  <!-- Game references and target framework come from ..\Directory.Build.props.
       Deploying to the game is opt-in: see ..\Directory.Build.targets. -->
  <PropertyGroup>
    <AssemblyName>ChatRange</AssemblyName>
    <RootNamespace>ChatRange</RootNamespace>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- The list: drawn with TextMeshPro so styled player names show properly, and hidden
         while Photo Mode takes a photo. -->
    <Compile Include="..\Shared\PanelStack.cs" Link="Shared\PanelStack.cs" />
    <Compile Include="..\Shared\TextBox.cs" Link="Shared\TextBox.cs" />
    <Compile Include="..\Shared\PlayerNames.cs" Link="Shared\PlayerNames.cs" />
  </ItemGroup>
</Project>
