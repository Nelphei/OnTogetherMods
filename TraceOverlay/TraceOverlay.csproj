<Project Sdk="Microsoft.NET.Sdk">
  <!-- Game references and target framework come from ..\Directory.Build.props.
       Deploying to the game is opt-in: see ..\Directory.Build.targets. -->
  <PropertyGroup>
    <AssemblyName>TraceOverlay</AssemblyName>
    <RootNamespace>TraceOverlay</RootNamespace>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Stacks this mod's window with other mods' windows, and stops clicks going through it. -->
    <Compile Include="..\Shared\PanelStack.cs" Link="Shared\PanelStack.cs" />
    <Compile Include="..\Shared\ClickBlocker.cs" Link="Shared\ClickBlocker.cs" />
  </ItemGroup>
</Project>
