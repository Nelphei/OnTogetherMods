<Project Sdk="Microsoft.NET.Sdk">
  <!-- Game references and target framework come from ..\Directory.Build.props.
       Deploying to the game is opt-in: see ..\Directory.Build.targets. -->
  <PropertyGroup>
    <AssemblyName>NameDesigner</AssemblyName>
    <RootNamespace>NameDesigner</RootNamespace>
    <Version>0.2.4</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Stacks this mod's window with other mods' windows. -->
    <Compile Include="..\Shared\PanelStack.cs" Link="Shared\PanelStack.cs" />
    <!-- This mod's icon in the row of mod icons at the bottom-right. -->
    <Compile Include="..\Shared\IconBar.cs" Link="Shared\IconBar.cs" />
    <!-- Keeps clicks on the window from reaching the game's UI. -->
    <Compile Include="..\Shared\ClickBlocker.cs" Link="Shared\ClickBlocker.cs" />
    <!-- The preview: drawn with TextMeshPro, like the name tags. -->
    <Compile Include="..\Shared\TextBox.cs" Link="Shared\TextBox.cs" />
    <Compile Include="..\Shared\PlayerNames.cs" Link="Shared\PlayerNames.cs" />
    <!-- Designs the session name in Session Manager's window too, when that mod is installed. -->
    <Compile Include="..\Shared\SessionNameLink.cs" Link="Shared\SessionNameLink.cs" />
    <!-- Opens beside Card Designer's window for the name line of the ID card, when that mod is installed. -->
    <Compile Include="..\Shared\NameDesignerLink.cs" Link="Shared\NameDesignerLink.cs" />
    <!-- The colour square and hue strip (shared with Card Designer). -->
    <Compile Include="..\Shared\ColorPicker.cs" Link="Shared\ColorPicker.cs" />
  </ItemGroup>
</Project>
